{
  "crons": [
    {
      "path": "/api/mercadopago/sincronizar-cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/garantia/cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/retencao/cron",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/entrega/watchdog",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.commerly.com.br" }],
      "destination": "https://commerly.com.br/:path*",
      "permanent": true
    }
  ]
}
